<UserControl x:Class="VraiPseudoSae.view.DropItemsPages.Decors.DecorAube"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VraiPseudoSae.view.DropItemsPages.Decors"
             mc:Ignorable="d" 
             d:DesignHeight="810" d:DesignWidth="800">
    <Grid>
        <Rectangle Width="800" Height="810" VerticalAlignment="Top">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4A6572" Offset="0.0"/>
                    <GradientStop Color="#8EA8BD" Offset="0.25"/>
                    <GradientStop Color="#D9A5B3" Offset="0.4"/>
                    <GradientStop Color="#FCA766" Offset="0.55"/>
                    <GradientStop Color="#FF7A33" Offset="0.7"/>
                    <GradientStop Color="#D34511" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="500" Height="500" Margin="0,160,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FFFFE0" Offset="0.0"/>
                    <GradientStop Color="#FF9E33" Offset="0.2"/>
                    <GradientStop Color="#FF7F23" Offset="0.23"/>
                    <GradientStop Color="#FF6E13" Offset="0.27"/>
                    <GradientStop Color="#FF5500" Offset="0.3"/>
                    <GradientStop Color="#00FF5500" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="50" Height="50" Margin="0,385,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="White">
            <Ellipse.Effect>
                <BlurEffect Radius="10"/>
            </Ellipse.Effect>
        </Ellipse>

        <Rectangle Width="800" Height="400" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF8A45" Offset="0.0"/>
                    <GradientStop Color="#D34511" Offset="0.15"/>
                    <GradientStop Color="#5C2E29" Offset="0.4"/>
                    <GradientStop Color="#121820" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="120" Height="400" VerticalAlignment="Bottom" Opacity="0.3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0.0"/>
                    <GradientStop Color="#FFFFE0" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="40"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</UserControl>
