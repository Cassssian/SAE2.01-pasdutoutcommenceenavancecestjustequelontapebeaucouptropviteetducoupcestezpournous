<Page x:Class="VraiPseudoSae.view.DropItems"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VraiPseudoSae.view"
      mc:Ignorable="d" 
      d:DesignHeight="810" d:DesignWidth="800"
      Title="DropItems" Background="#1A1A2E" KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="810"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        
        <ContentControl x:Name="ConteneurDecor" Grid.Column="1" Grid.Row="0"/>

        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="#000000" Stroke="#101015" 
                   StrokeThickness="2" Grid.Row="0" Grid.Column="0"/>

        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="#000000" Stroke="#101015" 
                   StrokeThickness="0" Grid.Row="0" Grid.Column="2"/>

        <Rectangle Height="50" VerticalAlignment="Stretch" Fill="#000000" Stroke="#000000" HorizontalAlignment="Stretch" 
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>

        <Canvas x:Name="GameCanvas" Grid.Column="1" Grid.Row="0" Background="Transparent"/>
    </Grid>
</Page>
