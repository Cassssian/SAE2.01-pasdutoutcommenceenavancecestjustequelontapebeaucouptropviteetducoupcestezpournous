<Window x:Class="VraiPseudoSae.view.FootGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Foot"
        Width="1280"
        Height="820"
        Background="#1B1B1B"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Zone stade -->
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="95"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="95"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>

            <!-- Tribunes haut -->
            <Canvas x:Name="TopStand" Grid.Row="0" Grid.Column="1" Background="#595959" Height="95"/>

            <!-- Tribunes bas -->
            <Canvas x:Name="BottomStand" Grid.Row="2" Grid.Column="1" Background="#595959" Height="95"/>

            <!-- Tribunes gauche -->
            <Canvas x:Name="LeftStand" Grid.Row="1" Grid.Column="0" Background="#666666" Width="95"/>

            <!-- Tribunes droite -->
            <Canvas x:Name="RightStand" Grid.Row="1" Grid.Column="2" Background="#666666" Width="95"/>

            <!-- Coins -->
            <Border Grid.Row="0" Grid.Column="0" Background="#4C4C4C" CornerRadius="14,0,0,0"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#4C4C4C" CornerRadius="0,14,0,0"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#4C4C4C" CornerRadius="0,0,0,14"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#4C4C4C" CornerRadius="0,0,14,0"/>

            <!-- Terrain -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="#2B7D4F"
                    BorderBrush="#E8E8E8"
                    BorderThickness="4"
                    CornerRadius="4">
                <Canvas x:Name="GameCanvas"
                        Width="960"
                        Height="560"
                        Background="#2E8B57"
                        Focusable="True">

                    <!-- Pelouse -->
                    <Rectangle Width="960" Height="560" Fill="#2E8B57"/>
                    <Rectangle Width="960" Height="80" Canvas.Top="80" Fill="#389A61" Opacity="0.35"/>
                    <Rectangle Width="960" Height="80" Canvas.Top="240" Fill="#389A61" Opacity="0.35"/>
                    <Rectangle Width="960" Height="80" Canvas.Top="400" Fill="#389A61" Opacity="0.35"/>

                    <!-- Lignes -->
                    <Rectangle Width="960" Height="560" Stroke="White" StrokeThickness="4" Fill="Transparent"/>
                    <Line X1="480" Y1="0" X2="480" Y2="560" Stroke="White" StrokeThickness="4"/>
                    <Ellipse Width="132" Height="132" Stroke="White" StrokeThickness="4" Fill="Transparent"
                             Canvas.Left="414" Canvas.Top="214"/>
                    <Ellipse Width="8" Height="8" Fill="White" Canvas.Left="476" Canvas.Top="276"/>

                    <!-- Surface gauche -->
                    <Rectangle Width="150" Height="270" Stroke="White" StrokeThickness="4" Fill="Transparent"
                               Canvas.Left="0" Canvas.Top="145"/>
                    <Rectangle Width="58" Height="150" Stroke="White" StrokeThickness="4" Fill="Transparent"
                               Canvas.Left="0" Canvas.Top="205"/>
                    <Ellipse Width="8" Height="8" Fill="White" Canvas.Left="100" Canvas.Top="276"/>

                    <!-- Surface droite -->
                    <Rectangle Width="150" Height="270" Stroke="White" StrokeThickness="4" Fill="Transparent"
                               Canvas.Left="810" Canvas.Top="145"/>
                    <Rectangle Width="58" Height="150" Stroke="White" StrokeThickness="4" Fill="Transparent"
                               Canvas.Left="902" Canvas.Top="205"/>
                    <Ellipse Width="8" Height="8" Fill="White" Canvas.Left="852" Canvas.Top="276"/>

                    <!-- Cages -->
                    <Rectangle x:Name="LeftGoal"
                               Width="18" Height="120"
                               Fill="#ECECEC" Stroke="#BDBDBD" StrokeThickness="2"
                               Canvas.Left="-8" Canvas.Top="220"/>

                    <Rectangle x:Name="RightGoal"
                               Width="18" Height="120"
                               Fill="#ECECEC" Stroke="#BDBDBD" StrokeThickness="2"
                               Canvas.Left="950" Canvas.Top="220"/>

                    <!-- Overlays -->
                    <Canvas x:Name="EffectsCanvas" Width="960" Height="560" Background="Transparent"/>
                </Canvas>
            </Border>
        </Grid>

        <!-- Sources XAML pour les sprites injectés dans IUTGame -->
        <Canvas x:Name="PlayerSpriteSource" Width="24" Height="24" Visibility="Collapsed">
            <Ellipse Width="24" Height="24" Fill="OrangeRed" Stroke="White" StrokeThickness="2"/>
        </Canvas>
        <Canvas x:Name="BotSpriteSource" Width="24" Height="24" Visibility="Collapsed">
            <Ellipse Width="24" Height="24" Fill="DodgerBlue" Stroke="White" StrokeThickness="2"/>
        </Canvas>
        <Canvas x:Name="BallSpriteSource" Width="14" Height="14" Visibility="Collapsed">
            <Ellipse Width="14" Height="14" Fill="WhiteSmoke" Stroke="Black" StrokeThickness="1.2"/>
        </Canvas>

        <!-- HUD principal -->
        <Border x:Name="HudPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="290"
                Margin="0,22,22,0"
                Background="#2A2A2AE6"
                CornerRadius="16"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Mini Foot" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock x:Name="ScoreText" Text="Rouge 0 - 0 Bleu" Foreground="White" FontSize="22" Margin="0,14,0,10"/>
                <TextBlock x:Name="StatusText" Text="Flèches pour bouger" Foreground="#E0E0E0" FontSize="16" TextWrapping="Wrap"/>

                <TextBlock Text="Compétences" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>

                <StackPanel x:Name="SkillPanel" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Canvas x:Name="DashIcon" Width="28" Height="28"/>
                        <TextBlock x:Name="DashText" Text="Dash : prêt" Foreground="#9FE870" Margin="10,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Canvas x:Name="ShotIcon" Width="28" Height="28"/>
                        <TextBlock x:Name="ShotText" Text="Tir : prêt" Foreground="#9FE870" Margin="10,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Canvas x:Name="DribbleIcon" Width="28" Height="28"/>
                        <TextBlock x:Name="DribbleText" Text="Dribble : prêt" Foreground="#9FE870" Margin="10,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,18,0,18"/>

                <TextBlock Text="Commandes" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Flèches : déplacement" Foreground="#D0D0D0" Margin="0,8,0,0"/>
                <TextBlock Text="Shift : dash" Foreground="#D0D0D0" Margin="0,4,0,0"/>
                <TextBlock Text="Espace : tir" Foreground="#D0D0D0" Margin="0,4,0,0"/>
                <TextBlock Text="Ctrl : dribble demi-cercle" Foreground="#D0D0D0" Margin="0,4,0,0"/>
                <TextBlock Text="C : afficher / cacher HUD" Foreground="#D0D0D0" Margin="0,4,0,0"/>
                <TextBlock Text="R : recommencer" Foreground="#D0D0D0" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Mini HUD si panneau fermé -->
        <Border x:Name="CompactHud"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#1F1F1FD8"
                CornerRadius="14"
                Padding="10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="CompactScoreText" Text="0 - 0" Foreground="White" FontSize="18" HorizontalAlignment="Right"/>
                <TextBlock x:Name="CompactStatusText" Text="C pour HUD" Foreground="#D5D5D5" FontSize="14" Margin="0,4,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Canvas x:Name="CompactDashIcon" Width="24" Height="24" Margin="0,0,6,0"/>
                    <Canvas x:Name="CompactShotIcon" Width="24" Height="24" Margin="0,0,6,0"/>
                    <Canvas x:Name="CompactDribbleIcon" Width="24" Height="24"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Popup aide premier lancement -->
<Grid x:Name="IntroOverlay"
      Background="#B0000000"
      Visibility="Visible">
    <Border Width="520"
            Padding="24"
            Background="#2C2C2C"
            CornerRadius="18"
            BorderBrush="#5E5E5E"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Bienvenue dans Mini Foot"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock Text="Commandes"
                       Foreground="White"
                       FontSize="22"
                       Margin="0,18,0,10"/>

            <TextBlock Text="• Flèches : déplacement"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>
            <TextBlock Text="• Shift : dash"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>
            <TextBlock Text="• Espace : tir"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>
            <TextBlock Text="• Ctrl : dribble en demi-cercle"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>
            <TextBlock Text="• C : cacher / afficher le HUD"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>
            <TextBlock Text="• Échap : pause"
                       Foreground="#D8D8D8"
                       FontSize="17"
                       Margin="0,4,0,0"/>

            <TextBlock Text="Appuie sur Entrée pour commencer"
                       Foreground="#9FE870"
                       FontSize="18"
                       Margin="0,22,0,0"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</Grid>

<!-- Pause -->
<Grid x:Name="PauseOverlay"
      Background="#96000000"
      Visibility="Collapsed">
    <Border Width="420"
            Padding="22"
            Background="#2B2B2B"
            CornerRadius="18"
            BorderBrush="#6B6B6B"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Pause"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Échap : reprendre"
                       Foreground="#DADADA"
                       FontSize="18"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="R : relancer le match"
                       Foreground="#DADADA"
                       FontSize="18"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="C : masquer / afficher le HUD"
                       Foreground="#DADADA"
                       FontSize="18"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Grid>
    </Grid>
</Window>