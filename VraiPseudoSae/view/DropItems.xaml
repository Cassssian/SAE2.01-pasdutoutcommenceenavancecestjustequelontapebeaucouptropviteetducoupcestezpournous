<Page x:Class="VraiPseudoSae.view.DropItems"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VraiPseudoSae.view"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="DropItems" Background="#1A1A2E">

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0,0" StartPoint="0,0">
                    <GradientStop Color="#151515" Offset="0"/>
                    <GradientStop Color="#151515" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1, 0">
                    <GradientStop Color="#0F0F22" Offset="0.7"/>
                    <GradientStop Color="#191970" Offset="0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas IsHitTestVisible="False" Margin="40,0,40,50">
            <Ellipse Canvas.Left="50" Canvas.Top="100" Width="10" Height="10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF00" Offset="0"/>
                        <GradientStop Color="#00FFFF00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="250" Canvas.Top="50" Width="8" Height="8">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFCEE" Offset="0"/>
                        <GradientStop Color="#00FFFF00" Offset="0.8"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="500" Canvas.Top="180" Width="12" Height="12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF00" Offset="0"/>
                        <GradientStop Color="#00FFFF00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="120" Canvas.Top="300" Width="6" Height="6">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF00" Offset="0"/>
                        <GradientStop Color="#00FFFF00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="650" Canvas.Top="120" Width="9" Height="9">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF00" Offset="0"/>
                        <GradientStop Color="#00FFFF00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Rectangle Width="40" HorizontalAlignment="Left" Fill="#000000" Stroke="#101015" StrokeThickness="2"/>
        <StackPanel Width="40" HorizontalAlignment="Left">
            <Rectangle Height="20" Margin="5,10" Fill="#000000"/>
            <Rectangle Height="20" Margin="15,10" Fill="#000000"/>
            <Rectangle Height="20" Margin="5,15" Fill="#000000"/>
            <Rectangle Height="20" Margin="10,10" Fill="#000000"/>
        </StackPanel>

        <Rectangle Width="40" HorizontalAlignment="Right" Fill="#000000" Stroke="#101015" StrokeThickness="0"/>
        <StackPanel Width="40" HorizontalAlignment="Right">
            <Rectangle Height="20" Margin="15,10" Fill="#000000"/>
            <Rectangle Height="20" Margin="5,10" Fill="#000000"/>
            <Rectangle Height="20" Margin="15,15" Fill="#000000"/>
            <Rectangle Height="20" Margin="5,10" Fill="#000000"/>
        </StackPanel>

        <Rectangle Height="50" VerticalAlignment="Bottom" Fill="#000000" Stroke="#000000" StrokeThickness="3"/>
        <Rectangle Height="2" VerticalAlignment="Bottom" Margin="40,0,40,48" Fill="#444455"/>

        <Canvas x:Name="GameCanvas" Margin="40,0,40,50" Background="Transparent"/>

    </Grid>
</Page>
