<Window x:Class="VraiPseudoSae.view.Pinball.PinballGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Pinball for Windows - Space Cadet"
        Width="600" Height="780"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ScoreText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0d0d1a">
        <!-- Bandeau top (style XP) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- HUD supérieur -->
        <Grid Grid.Row="0" Background="#1c1c3a">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="SCORE" Style="{StaticResource ScoreText}" FontSize="11"/>
                <TextBlock x:Name="ScoreText" Text="0" Style="{StaticResource ScoreText}" FontSize="20"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="3D PINBALL" Foreground="#4fc3f7" FontSize="16" FontWeight="Bold"
                           FontFamily="Arial" HorizontalAlignment="Center"/>
                <TextBlock Text="SPACE CADET" Foreground="#b0bec5" FontSize="10"
                           FontFamily="Arial" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                <TextBlock Text="BILLES" Style="{StaticResource ScoreText}" FontSize="11"/>
                <TextBlock x:Name="BallsText" Text="3" Style="{StaticResource ScoreText}" FontSize="20"/>
            </StackPanel>
        </Grid>

        <!-- Table de jeu -->
        <Canvas x:Name="GameCanvas" Grid.Row="1"
                Width="580" Height="660"
                HorizontalAlignment="Center"
                ClipToBounds="True">

            <!-- Fond de table -->
            <Rectangle Width="580" Height="660" Canvas.Left="0" Canvas.Top="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0a1628" Offset="0"/>
                        <GradientStop Color="#0d2040" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Murs latéraux -->
            <Rectangle x:Name="WallLeft" Width="12" Height="660" Canvas.Left="0" Canvas.Top="0"
                       Fill="#2a4a8a" RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="WallRight" Width="12" Height="660" Canvas.Left="568" Canvas.Top="0"
                       Fill="#2a4a8a" RadiusX="2" RadiusY="2"/>
            <!-- Mur du haut -->
            <Rectangle Width="580" Height="12" Canvas.Left="0" Canvas.Top="0"
                       Fill="#2a4a8a"/>

            <!-- Zone de lancement (droite) -->
            <Rectangle Width="30" Height="560" Canvas.Left="538" Canvas.Top="90"
                       Fill="#111133" Stroke="#2a4a8a" StrokeThickness="2"/>
            <TextBlock Text="LAUNCH" Foreground="#334" FontSize="9" Canvas.Left="540" Canvas.Top="300"
                       FontFamily="Courier New">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>

            <!-- ===== ÉLÉMENTS DE DÉCORATION (style Space Cadet) ===== -->

            <!-- Cercle central (mission control) -->
            <Ellipse Width="120" Height="120" Canvas.Left="200" Canvas.Top="80"
                     Stroke="#4fc3f7" StrokeThickness="2" Fill="#0a1a3a"/>
            <Ellipse Width="100" Height="100" Canvas.Left="210" Canvas.Top="90"
                     Stroke="#1e88e5" StrokeThickness="1" Fill="Transparent"/>
            <TextBlock Text="SPACE" Foreground="#4fc3f7" FontSize="11" FontWeight="Bold"
                       FontFamily="Arial" Canvas.Left="232" Canvas.Top="132"/>
            <TextBlock Text="CADET" Foreground="#4fc3f7" FontSize="11" FontWeight="Bold"
                       FontFamily="Arial" Canvas.Left="229" Canvas.Top="147"/>

            <!-- Bumpers (cercles lumineux) -->
            <Ellipse x:Name="Bumper1" Width="46" Height="46" Canvas.Left="107" Canvas.Top="95"
                     Fill="#1565c0" Stroke="#42a5f5" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="115" Canvas.Top="103"
                     Fill="#1976d2" Stroke="#90caf9" StrokeThickness="1"/>
            <TextBlock Text="100" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="113" Canvas.Top="115"/>

            <Ellipse x:Name="Bumper2" Width="46" Height="46" Canvas.Left="157" Canvas.Top="55"
                     Fill="#1565c0" Stroke="#42a5f5" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="165" Canvas.Top="63"
                     Fill="#1976d2" Stroke="#90caf9" StrokeThickness="1"/>
            <TextBlock Text="100" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="163" Canvas.Top="75"/>

            <Ellipse x:Name="Bumper3" Width="46" Height="46" Canvas.Left="330" Canvas.Top="55"
                     Fill="#1565c0" Stroke="#42a5f5" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="338" Canvas.Top="63"
                     Fill="#1976d2" Stroke="#90caf9" StrokeThickness="1"/>
            <TextBlock Text="100" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="336" Canvas.Top="75"/>

            <Ellipse x:Name="Bumper4" Width="46" Height="46" Canvas.Left="375" Canvas.Top="95"
                     Fill="#c62828" Stroke="#ef9a9a" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="383" Canvas.Top="103"
                     Fill="#d32f2f" Stroke="#ffcdd2" StrokeThickness="1"/>
            <TextBlock Text="200" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="381" Canvas.Top="115"/>

            <Ellipse x:Name="Bumper5" Width="46" Height="46" Canvas.Left="100" Canvas.Top="170"
                     Fill="#1b5e20" Stroke="#a5d6a7" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="108" Canvas.Top="178"
                     Fill="#2e7d32" Stroke="#c8e6c9" StrokeThickness="1"/>
            <TextBlock Text="150" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="106" Canvas.Top="190"/>

            <Ellipse x:Name="Bumper6" Width="46" Height="46" Canvas.Left="382" Canvas.Top="170"
                     Fill="#1b5e20" Stroke="#a5d6a7" StrokeThickness="3"/>
            <Ellipse Width="30" Height="30" Canvas.Left="390" Canvas.Top="178"
                     Fill="#2e7d32" Stroke="#c8e6c9" StrokeThickness="1"/>
            <TextBlock Text="150" Foreground="White" FontSize="8" FontWeight="Bold"
                       FontFamily="Courier New" Canvas.Left="388" Canvas.Top="190"/>

            <!-- Cibles rectangulaires (drop targets) -->
            <Rectangle x:Name="Target1" Width="40" Height="10" Canvas.Left="130" Canvas.Top="265"
                       Fill="#f57f17" Stroke="#ffcc02" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="Target2" Width="40" Height="10" Canvas.Left="180" Canvas.Top="265"
                       Fill="#f57f17" Stroke="#ffcc02" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="Target3" Width="40" Height="10" Canvas.Left="230" Canvas.Top="265"
                       Fill="#f57f17" Stroke="#ffcc02" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="Target4" Width="40" Height="10" Canvas.Left="310" Canvas.Top="265"
                       Fill="#e53935" Stroke="#ff6b6b" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="Target5" Width="40" Height="10" Canvas.Left="360" Canvas.Top="265"
                       Fill="#e53935" Stroke="#ff6b6b" StrokeThickness="1" RadiusX="2" RadiusY="2"/>

            <!-- Ramps (rampes) - lignes diagonales style XP -->
            <Line X1="12" Y1="240" X2="90" Y2="340" Stroke="#3a6aaa" StrokeThickness="5"/>
            <Line X1="536" Y1="240" X2="460" Y2="340" Stroke="#3a6aaa" StrokeThickness="5"/>

            <!-- Zone centrale basse (slingshots) -->
            <Line X1="12" Y1="370" X2="100" Y2="450" Stroke="#5a8acc" StrokeThickness="4"/>
            <Line X1="536" Y1="370" X2="448" Y2="450" Stroke="#5a8acc" StrokeThickness="4"/>

            <!-- Passage gauche (outlane) -->
            <Line X1="12" Y1="450" X2="12" Y2="580" Stroke="#2a4a8a" StrokeThickness="12"/>
            <Line X1="90" Y1="450" X2="90" Y2="580" Stroke="#2a4a8a" StrokeThickness="4"/>

            <!-- Passage droit (outlane) -->
            <Line X1="536" Y1="450" X2="536" Y2="580" Stroke="#2a4a8a" StrokeThickness="12"/>
            <Line X1="448" Y1="450" X2="448" Y2="580" Stroke="#2a4a8a" StrokeThickness="4"/>

            <!-- Bords inclinés bas (gutters) -->
            <Line X1="12" Y1="580" X2="155" Y2="635" Stroke="#4a7acc" StrokeThickness="6"/>
            <Line X1="536" Y1="580" X2="393" Y2="635" Stroke="#4a7acc" StrokeThickness="6"/>

            <!-- Flippers -->
            <Polygon x:Name="FlipperLeft"
                     Points="75,635 195,619 195,627"
                     Fill="#e0e0e0" Stroke="#9e9e9e" StrokeThickness="1"/>
            <Polygon x:Name="FlipperRight"
                     Points="475,635 353,619 353,627"
                     Fill="#e0e0e0" Stroke="#9e9e9e" StrokeThickness="1"/>

            <!-- Ressort de lancement -->
            <Rectangle x:Name="Plunger" Width="18" Height="60"
                       Canvas.Left="542" Canvas.Top="590"
                       Fill="#8a8a8a" Stroke="#bbb" StrokeThickness="1" RadiusX="3" RadiusY="3"/>

            <!-- Lumières déco supplémentaires -->
            <Ellipse Width="10" Height="10" Canvas.Left="200" Canvas.Top="300"
                     Fill="#ff7043" Opacity="0.8"/>
            <Ellipse Width="10" Height="10" Canvas.Left="260" Canvas.Top="300"
                     Fill="#ff7043" Opacity="0.8"/>
            <Ellipse Width="10" Height="10" Canvas.Left="320" Canvas.Top="300"
                     Fill="#ff7043" Opacity="0.8"/>

            <!-- Textes indicateurs -->
            <TextBlock Text="EXTRA BALL" Foreground="#ffb300" FontSize="8" FontFamily="Courier New"
                       FontWeight="Bold" Canvas.Left="215" Canvas.Top="50"/>
            <TextBlock Text="JACKPOT" Foreground="#e91e63" FontSize="8" FontFamily="Courier New"
                       FontWeight="Bold" Canvas.Left="155" Canvas.Top="300"/>
            <TextBlock Text="BONUS" Foreground="#00bcd4" FontSize="8" FontFamily="Courier New"
                       FontWeight="Bold" Canvas.Left="360" Canvas.Top="300"/>

            <!-- Bille (initialement positionnée en bas à droite) -->
            <Ellipse x:Name="Ball" Width="18" Height="18"
                     Canvas.Left="545" Canvas.Top="570">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                        <GradientStop Color="#e0e0e0" Offset="0"/>
                        <GradientStop Color="#9e9e9e" Offset="0.7"/>
                        <GradientStop Color="#616161" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

        </Canvas>

        <!-- HUD inférieur : contrôles -->
        <Grid Grid.Row="2" Background="#1c1c3a">
            <TextBlock Text="[Z] Flipper Gauche    |    ESPACE : Lancer    |    [/] Flipper Droit"
                       Foreground="#b0bec5" FontSize="11" FontFamily="Courier New"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Overlay : Game Over -->
        <Border x:Name="GameOverOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#CC000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="GAME OVER" Foreground="#f44336" FontSize="52"
                           FontWeight="Bold" FontFamily="Arial" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FinalScoreText" Text="Score final : 0"
                           Foreground="#FFD700" FontSize="24" FontFamily="Courier New"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Button Content="Rejouer" Click="BtnReplay_Click"
                        Width="150" Height="40" Margin="0,20,0,0"
                        Background="#1565c0" Foreground="White" FontSize="16"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Quitter" Click="BtnQuit_Click"
                        Width="150" Height="40" Margin="0,10,0,0"
                        Background="#333" Foreground="White" FontSize="16"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Overlay : Prêt -->
        <Border x:Name="ReadyOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#99000000" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="3D PINBALL" Foreground="#4fc3f7" FontSize="44"
                           FontWeight="Bold" FontFamily="Arial" HorizontalAlignment="Center"/>
                <TextBlock Text="SPACE CADET" Foreground="#90caf9" FontSize="22"
                           FontFamily="Arial" HorizontalAlignment="Center"/>
                <TextBlock Text="Appuie sur ESPACE pour lancer la bille"
                           Foreground="#FFD700" FontSize="14" FontFamily="Courier New"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Text="[Z] Flipper Gauche    [/] Flipper Droit"
                           Foreground="#b0bec5" FontSize="12" FontFamily="Courier New"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
