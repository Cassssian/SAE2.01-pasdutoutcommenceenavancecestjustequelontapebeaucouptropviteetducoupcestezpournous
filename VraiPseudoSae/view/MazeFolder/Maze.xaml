<Window x:Class="VraiPseudoSae.view.Maze"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Maze"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
            <TextBlock x:Name="InfoText"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Text="Déplace-toi avec les flèches jusqu'à la sortie verte."/>

            <!-- Timer UI -->
            <Border x:Name="TimerBorder"
                    Margin="20,0,0,0"
                    Padding="12,4"
                    CornerRadius="8"
                    Background="#22AA22"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱ "
                               Foreground="White"
                               FontSize="18"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerText"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="--"/>
                </StackPanel>
            </Border>

            <!-- Téléportation UI -->
            <Border x:Name="TeleportBorder"
                    Margin="16,0,0,0"
                    Padding="12,4"
                    CornerRadius="8"
                    Background="#1A1A2E"
                    BorderBrush="#5C5CFF"
                    BorderThickness="2"
                    VerticalAlignment="Center">
                <Border.Resources>
                    <!-- Animation pulse quand prête -->
                    <Storyboard x:Key="PulseReady" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="TeleportBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.55" Duration="0:0:0.7"
                                         AutoReverse="True"
                                         EasingFunction="{x:Null}"/>
                    </Storyboard>
                    <!-- Animation spin de l'icône -->
                    <Storyboard x:Key="SpinIcon">
                        <DoubleAnimation Storyboard.TargetName="TeleportIconRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:0.4"/>
                    </Storyboard>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icône avec rotation -->
                    <TextBlock x:Name="TeleportIcon"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="⚡">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="TeleportIconRotate" Angle="0" CenterX="12" CenterY="12"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <!-- Label + état -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Téléport "
                                       Foreground="#AAAAFF"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TeleportStatusText"
                                       Foreground="#7777FF"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Text="[ESPACE]"/>
                        </StackPanel>
                        <!-- Barre de recharge -->
                        <Border Height="6"
                                Width="100"
                                CornerRadius="3"
                                Background="#333355"
                                Margin="0,3,0,0">
                            <Border x:Name="TeleportCooldownBar"
                                    Height="6"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="BarColorStart" Color="#5C5CFF" Offset="0"/>
                                        <GradientStop x:Name="BarColorEnd"   Color="#AA55FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="10"
                BorderBrush="White"
                BorderThickness="2"
                Background="Black"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Canvas x:Name="MazeCanvas"
                    Width="775"
                    Height="525"
                    Focusable="True"
                    Background="Black"/>
        </Border>
    </Grid>
</Window>