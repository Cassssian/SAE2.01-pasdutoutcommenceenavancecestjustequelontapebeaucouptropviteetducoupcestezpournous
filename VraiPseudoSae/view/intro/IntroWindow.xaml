<UserControl x:Class="VraiPseudoSae.view.intro.IntroWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280"
             Height="720"
             Focusable="True"
             KeyDown="Window_KeyDown"
             Loaded="Window_Loaded"
             UseLayoutRounding="True">

    <Grid x:Name="IntroRoot" ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.76" RadiusY="0.86">
                <GradientStop Color="#10284D" Offset="0"/>
                <GradientStop Color="#050B1C" Offset="0.48"/>
                <GradientStop Color="#00040A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas x:Name="BackgroundCanvas" IsHitTestVisible="False"/>

        <Ellipse x:Name="BackdropGlow"
                 Width="820"
                 Height="250"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,-42,0,0"
                 Fill="#3344CFFF"
                 Opacity="0">
            <Ellipse.Effect>
                <BlurEffect Radius="70"/>
            </Ellipse.Effect>
        </Ellipse>

        <Viewbox Width="960"
                 Height="378"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,-36,0,0"
                 Stretch="Uniform">
            <Canvas x:Name="LogoCanvas"
                    Width="579"
                    Height="228"
                    ClipToBounds="True"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.78" ScaleY="0.78"/>
                        <TranslateTransform x:Name="LogoTranslate" Y="26"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Canvas x:Name="DecorationLayer"
                        IsHitTestVisible="False"/>

                <Image Source="pack://application:,,,/view/intro/logo_text.png"
                       Width="579"
                       Height="228"
                       Stretch="Fill"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Rectangle x:Name="LogoShine"
                           Width="76"
                           Height="330"
                           Canvas.Left="-118"
                           Canvas.Top="-50"
                           Opacity="0"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="0.48"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-18"/>
                            <TranslateTransform x:Name="LogoShineTranslate" X="0"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Viewbox>

        <Border x:Name="AuthorsPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,88"
                Padding="18,9"
                Background="#7A000612"
                BorderBrush="#665FE8FF"
                BorderThickness="1"
                CornerRadius="3"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AuthorsTranslate" Y="16"/>
            </Border.RenderTransform>
            <TextBlock Text="Enzo Ducceschi (&#x023B;&#x03BB;&#x01A7;&#x1E68;&#x0286;&#x0283;&#x0142;&#x0E04;&#x0438;) - Antoine Armand - Hugo Banderier - Mohammad-Ali Mohammadi"
                       Foreground="#D9F7FF"
                       FontFamily="{StaticResource PixelFontDisplayStyle}"
                       FontSize="16"
                       TextOptions.TextRenderingMode="Aliased"
                       TextOptions.TextFormattingMode="Display"/>
        </Border>

        <Border x:Name="PressPromptPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Padding="16,8"
                Background="#8A020915"
                BorderBrush="#CC7DFFB8"
                BorderThickness="2"
                CornerRadius="3"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="#5FE8FF"
                                  BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.72"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PressPromptTranslate" Y="12"/>
            </Border.RenderTransform>
            <TextBlock x:Name="PressPromptText"
                       Text="Appuyez sur la touche espace pour accéder au jeu"
                       Foreground="#B8FFD6"
                       FontFamily="{StaticResource PixelFont}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextOptions.TextRenderingMode="Aliased"
                       TextOptions.TextFormattingMode="Display">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#5FE8FF"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity="0.95"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <Rectangle x:Name="ScanlineOverlay"
                   Opacity="0.16"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush Viewport="0,0,1,4"
                              ViewportUnits="Absolute"
                              TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#337DFFB8">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="ExitFade"
                   Fill="#00040A"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
