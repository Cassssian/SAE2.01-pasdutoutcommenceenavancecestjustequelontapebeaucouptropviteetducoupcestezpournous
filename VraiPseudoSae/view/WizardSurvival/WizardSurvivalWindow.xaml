<Window x:Class="VraiPseudoSae.view.WizardSurvival.WizardSurvivalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VraiPseudoSae.view.WizardSurvival"
        Title="Nuit du Code - Wizard Survival"
        Width="820"
        Height="660"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#121820"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#43516A"/>
            <Setter Property="BorderBrush" Value="#91A4C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="UpgradeButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Background" Value="#6A4D8B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="800"
                Height="600"
                BorderBrush="#2C374A"
                BorderThickness="2"
                Background="#1B242E"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Canvas x:Name="ViewportCanvas"
                    Width="800"
                    Height="600"
                    ClipToBounds="True">
                <Canvas x:Name="WorldLayer"
                        Width="1200"
                        Height="900"
                        IsHitTestVisible="False">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="WorldTransform"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <Canvas x:Name="SpriteCanvas"
                        Width="800"
                        Height="600"
                        Background="Transparent"
                        Focusable="True"
                        Panel.ZIndex="20"/>

                <Canvas x:Name="EffectLayer"
                        Width="800"
                        Height="600"
                        IsHitTestVisible="False"
                        Panel.ZIndex="30"/>

                <Canvas x:Name="HudLayer"
                        Width="800"
                        Height="600"
                        IsHitTestVisible="False"
                        Panel.ZIndex="40">
                    <Border Canvas.Left="12"
                            Canvas.Top="12"
                            Padding="10"
                            Background="#AA111923"
                            BorderBrush="#53627A"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ScoreText"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="Score: 0"/>
                            <TextBlock x:Name="LivesText"
                                       Foreground="#FF6B6B"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Text="Vie: 4/4"/>
                            <TextBlock x:Name="KillsText"
                                       Foreground="#C7D3E6"
                                       FontSize="13"
                                       Text="Zombies: 0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Canvas.Left="12"
                                Canvas.Top="96"
                                Width="210">
                        <TextBlock Text="Fireball [F]" Foreground="White" FontSize="12"/>
                        <Border Height="10" Background="#253041" BorderBrush="#52617A" BorderThickness="1">
                            <Rectangle x:Name="FireballCooldownFill" Fill="#EF6A3A" HorizontalAlignment="Left" Width="120"/>
                        </Border>
                        <TextBlock Text="Appel celeste [Espace]" Foreground="White" FontSize="12" Margin="0,7,0,0"/>
                        <Border Height="10" Background="#253041" BorderBrush="#52617A" BorderThickness="1">
                            <Rectangle x:Name="CelestialCooldownFill" Fill="#A46DE7" HorizontalAlignment="Left" Width="120"/>
                        </Border>
                        <TextBlock Text="Bouclier [B]" Foreground="White" FontSize="12" Margin="0,7,0,0"/>
                        <Border Height="10" Background="#253041" BorderBrush="#52617A" BorderThickness="1">
                            <Rectangle x:Name="ShieldCooldownFill" Fill="#23C7D9" HorizontalAlignment="Left" Width="120"/>
                        </Border>
                        <TextBlock Text="Laser [L]" Foreground="White" FontSize="12" Margin="0,7,0,0"/>
                        <Border Height="10" Background="#253041" BorderBrush="#52617A" BorderThickness="1">
                            <Rectangle x:Name="LaserCooldownFill" Fill="#F6C343" HorizontalAlignment="Left" Width="120"/>
                        </Border>
                    </StackPanel>

                    <Border Canvas.Right="12"
                            Canvas.Top="12"
                            Padding="8"
                            Background="#AA111923"
                            BorderBrush="#53627A"
                            BorderThickness="1">
                        <TextBlock x:Name="StateHintText"
                                   Foreground="#DDE6F5"
                                   FontSize="13"
                                   Text="A: ameliorations | ESC: pause"/>
                    </Border>
                </Canvas>

                <Grid x:Name="MenuOverlay"
                      Width="800"
                      Height="600"
                      Background="#DD0D1219"
                      Panel.ZIndex="80">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="330">
                        <TextBlock Text="NUIT DU CODE"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Survie du magicien"
                                   Foreground="#C5D3EA"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   Margin="0,4,0,18"/>
                        <Button Content="Jouer"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="StartButton_Click"/>
                        <Button Content="Quitter"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="QuitButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PauseOverlay"
                      Width="800"
                      Height="600"
                      Background="#CC05070B"
                      Panel.ZIndex="81"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="PAUSE"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <Button Content="Reprendre"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="ResumeButton_Click"/>
                        <Button Content="Menu principal"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BackToMenuButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="UpgradeOverlay"
                      Width="800"
                      Height="600"
                      Background="#DD0B1018"
                      Panel.ZIndex="82"
                      Visibility="Collapsed">
                    <Border Width="560"
                            Padding="18"
                            Background="#172131"
                            BorderBrush="#7281A1"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Ameliorations - cout 100"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Left"/>
                                <Button Content="X"
                                        Width="30"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Click="CloseUpgradeButton_Click"/>
                            </DockPanel>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Fireball"
                                               Foreground="#FFB07A"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Projectile plus rapide et recharge reduite."
                                               Foreground="#D7DEEC"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="UPGRADE"
                                        Tag="Fireball"
                                        Style="{StaticResource UpgradeButtonStyle}"
                                        Click="UpgradeButton_Click"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Appel celeste"
                                               Foreground="#C0A3FF"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Zone d'impact plus large."
                                               Foreground="#D7DEEC"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="UPGRADE"
                                        Tag="CelestialCall"
                                        Style="{StaticResource UpgradeButtonStyle}"
                                        Click="UpgradeButton_Click"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bouclier"
                                               Foreground="#7EE7F0"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Duree de protection augmentee."
                                               Foreground="#D7DEEC"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="UPGRADE"
                                        Tag="Shield"
                                        Style="{StaticResource UpgradeButtonStyle}"
                                        Click="UpgradeButton_Click"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rayon cosmique"
                                               Foreground="#FFE18A"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Degats du laser augmentes."
                                               Foreground="#D7DEEC"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="UPGRADE"
                                        Tag="Laser"
                                        Style="{StaticResource UpgradeButtonStyle}"
                                        Click="UpgradeButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="UpgradeStatusText"
                                       Margin="0,18,0,0"
                                       Foreground="#FFCE8A"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="GameOverOverlay"
                      Width="800"
                      Height="600"
                      Background="#DD05070B"
                      Panel.ZIndex="83"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="GAME OVER"
                                   Foreground="#FF6363"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="FinalScoreText"
                                   Foreground="White"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,8,0,14"/>
                        <Button Content="Recommencer"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="RestartButton_Click"/>
                        <Button Content="Menu principal"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BackToMenuButton_Click"/>
                    </StackPanel>
                </Grid>
            </Canvas>
        </Border>

        <Canvas x:Name="SpritePlayerSource" Width="34" Height="44" Visibility="Collapsed">
            <Ellipse Width="20" Height="7" Fill="#55000000" Canvas.Left="7" Canvas.Top="36"/>
            <Rectangle Width="18" Height="21" Fill="#5B4DD7" Canvas.Left="8" Canvas.Top="18" RadiusX="3" RadiusY="3"/>
            <Path Fill="#2C235F" Data="M4,20 L30,20 L24,8 L10,8 Z"/>
            <Path Fill="#8B73FF" Data="M6,11 L28,11 L17,0 Z"/>
            <Ellipse Width="16" Height="16" Fill="#F4C7A1" Canvas.Left="9" Canvas.Top="9"/>
            <Rectangle Width="22" Height="5" Fill="#F7E27A" Canvas.Left="6" Canvas.Top="26"/>
        </Canvas>

        <Canvas x:Name="SpriteZombieSource" Width="34" Height="38" Visibility="Collapsed">
            <Ellipse Width="21" Height="7" Fill="#55000000" Canvas.Left="6" Canvas.Top="31"/>
            <Rectangle Width="22" Height="22" Fill="#4C8F52" Canvas.Left="6" Canvas.Top="13" RadiusX="3" RadiusY="3"/>
            <Ellipse Width="18" Height="16" Fill="#6EB36F" Canvas.Left="8" Canvas.Top="2"/>
            <Rectangle Width="4" Height="3" Fill="#151515" Canvas.Left="12" Canvas.Top="8"/>
            <Rectangle Width="4" Height="3" Fill="#151515" Canvas.Left="20" Canvas.Top="8"/>
            <Rectangle Width="12" Height="3" Fill="#234628" Canvas.Left="11" Canvas.Top="17"/>
        </Canvas>

        <Canvas x:Name="SpriteZombieEvolvedSource" Width="34" Height="38" Visibility="Collapsed">
            <Ellipse Width="23" Height="8" Fill="#55000000" Canvas.Left="5" Canvas.Top="30"/>
            <Rectangle Width="24" Height="23" Fill="#7B3B8F" Canvas.Left="5" Canvas.Top="12" RadiusX="4" RadiusY="4"/>
            <Ellipse Width="20" Height="17" Fill="#A05FC1" Canvas.Left="7" Canvas.Top="1"/>
            <Path Fill="#ECE36A" Data="M8,1 L12,8 L5,8 Z"/>
            <Path Fill="#ECE36A" Data="M26,1 L22,8 L29,8 Z"/>
            <Rectangle Width="4" Height="3" Fill="#151515" Canvas.Left="12" Canvas.Top="8"/>
            <Rectangle Width="4" Height="3" Fill="#151515" Canvas.Left="21" Canvas.Top="8"/>
        </Canvas>

        <Canvas x:Name="SpriteFireballSource" Width="18" Height="18" Visibility="Collapsed">
            <Ellipse Width="14" Height="14" Canvas.Left="2" Canvas.Top="2" Fill="#FF6A2A"/>
            <Ellipse Width="8" Height="8" Canvas.Left="5" Canvas.Top="5" Fill="#FFD65A"/>
            <Path Fill="#FF302A" Data="M1,9 L8,3 L7,15 Z"/>
        </Canvas>
    </Grid>
</Window>
