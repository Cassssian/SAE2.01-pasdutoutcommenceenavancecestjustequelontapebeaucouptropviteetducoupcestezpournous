<UserControl x:Class="VraiPseudoSae.view.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VraiPseudoSae.view"
        Width="1280"
        Height="720"
        Focusable="True"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#101820">
        <Grid x:Name="CameraViewport"
              ClipToBounds="True">
            <Canvas x:Name="WorldLayer"
                    Width="1280"
                    Height="720"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WorldCameraScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                        <TranslateTransform x:Name="WorldCameraTranslate"
                                            X="0"
                                            Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Image x:Name="MapImage"
                       Width="1280"
                       Height="720"
                       Source="pack://application:,,,/Tilemap/homepage.png"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       IsHitTestVisible="False"/>

        <Canvas Name="GameCanvas"
                Width="1280"
                Height="720"
                Focusable="True"
                RenderOptions.BitmapScalingMode="NearestNeighbor">

            <!-- Sol 
            <Rectangle Width="1280" Height="260" Fill="#4FAE4F"
                       Canvas.Left="0" Canvas.Top="460"/>
                       
            <Polygon Points="420,720 860,720 760,420 520,420"
                     Fill="#8B7765"/>
                     -->

            <!-- Zone foot -->
            <Canvas Name="FootballZone" Width="170" Height="120"
                    Canvas.Left="930" Canvas.Top="360"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="#F4E285"/>
                <TextBlock Text="FOOT"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="52"
                           Canvas.Top="15"/>
            </Canvas>

            <!-- Zone RLS -->
            <Canvas Name="RLSZone" Width="170" Height="120"
                    Canvas.Left="550" Canvas.Top="360"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="DarkSlateGray"/>
                <TextBlock Text="RLS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="62"
                           Canvas.Top="15"/>
            </Canvas>

            <!-- Zone Nuit du Code -->
            <Canvas Name="PinZone" Width="170" Height="120"
                    Canvas.Left="850" Canvas.Top="550"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="#334B5F"/>
                <TextBlock Text="Wizard"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="46"
                           Canvas.Top="15"/>
            </Canvas>
            
            <!-- Zone labyrinthe -->
            <Canvas Name="MazeZone" Width="170" Height="120"
                    Canvas.Left="120" Canvas.Top="330"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="#C792EA"/>
                <TextBlock Text="LABY"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="50"
                           Canvas.Top="15"/>
            </Canvas>
            <local:StarControl Canvas.Right="10" Canvas.Top="10"/>
        </Canvas>
            </Canvas>
        </Grid>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10"
                Background="#AA000000"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Déplacement : ZQSD / WASD"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="18"/>
                <TextBlock Text="Interaction : E"
                           Foreground="White"
                           FontSize="15"/>
                <TextBlock Name="InfoText"
                           Text="Va vers une zone"
                           Foreground="#FFD966"
                           FontSize="16"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContent"/>
    </Grid>
</UserControl> 
