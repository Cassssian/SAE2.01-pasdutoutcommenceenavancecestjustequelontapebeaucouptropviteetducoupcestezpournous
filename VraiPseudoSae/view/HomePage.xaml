<Window x:Class="VraiPseudoSae.view.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VraiPseudoSae.view"
        Title="Retro Hub"
        Width="1280"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#101820"
        Loaded="Window_Loaded">

    <Grid>

        <Canvas Name="GameCanvas" Background="#87CEEB">

            <!-- Sol -->
            <Rectangle Width="1280" Height="260" Fill="#4FAE4F"
                       Canvas.Left="0" Canvas.Top="460"/>

            <!-- Route -->
            <Polygon Points="420,720 860,720 760,420 520,420"
                     Fill="#8B7765"/>

            <!-- Zone foot -->
            <Canvas Name="FootballZone" Width="170" Height="120"
                    Canvas.Left="930" Canvas.Top="360"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="#F4E285"/>
                <TextBlock Text="FOOT"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="52"
                           Canvas.Top="15"/>
            </Canvas>

            <!-- Zone RLS -->
            <Canvas Name="RLSZone" Width="170" Height="120"
                    Canvas.Left="550" Canvas.Top="360"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="DarkSlateGray"/>
                <TextBlock Text="RLS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="62"
                           Canvas.Top="15"/>
            </Canvas>

            <!-- Zone labyrinthe -->
            <Canvas Name="MazeZone" Width="170" Height="120"
                    Canvas.Left="120" Canvas.Top="330"
                    IsHitTestVisible="False">
                <Polygon Points="85,0 170,30 85,60 0,30"
                         Fill="#C792EA"/>
                <TextBlock Text="LABY"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Canvas.Left="50"
                           Canvas.Top="15"/>
            </Canvas>

            <!-- Arbres rétro -->
            <Canvas Canvas.Left="240" Canvas.Top="250" IsHitTestVisible="False">
                <Rectangle Width="18" Height="50" Fill="#6B3E26" Canvas.Left="22" Canvas.Top="42"/>
                <Ellipse Width="60" Height="60" Fill="#2E8B57"/>
            </Canvas>

            <Canvas Canvas.Left="980" Canvas.Top="260" IsHitTestVisible="False">
                <Rectangle Width="18" Height="50" Fill="#6B3E26" Canvas.Left="22" Canvas.Top="42"/>
                <Ellipse Width="60" Height="60" Fill="#2E8B57"/>
            </Canvas>

            <Canvas Canvas.Left="600" Canvas.Top="260" IsHitTestVisible="False">
                <Rectangle Width="18" Height="50" Fill="#6B3E26" Canvas.Left="22" Canvas.Top="42"/>
                <Ellipse Width="60" Height="60" Fill="#2E8B57"/>
            </Canvas>

            <local:StarControl Canvas.Right="10" Canvas.Top="10"/>
        </Canvas>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10"
                Background="#AA000000"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Déplacement : ZQSD / WASD"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="18"/>
                <TextBlock Text="Interaction : E"
                           Foreground="White"
                           FontSize="15"/>
                <TextBlock Name="InfoText"
                           Text="Va vers une zone"
                           Foreground="#FFD966"
                           FontSize="16"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source XAML du sprite du joueur -->
        <Canvas x:Name="PlayerSpriteSource"
                Width="60"
                Height="90"
                Visibility="Collapsed">
            <Ellipse Width="46" Height="14" Fill="#55000000"
                     Canvas.Left="7" Canvas.Top="72"/>

            <Rectangle Width="12" Height="24" Fill="#2244AA"
                       Canvas.Left="14" Canvas.Top="50"/>
            <Rectangle Width="12" Height="24" Fill="#2244AA"
                       Canvas.Left="34" Canvas.Top="50"/>

            <Rectangle Width="34" Height="30" Fill="#D95F43"
                       RadiusX="4" RadiusY="4"
                       Canvas.Left="13" Canvas.Top="24"/>

            <Ellipse Width="28" Height="28" Fill="#F2C29B"
                     Canvas.Left="16" Canvas.Top="2"/>

            <Rectangle Width="28" Height="10" Fill="#2B1B17"
                       RadiusX="3" RadiusY="3"
                       Canvas.Left="16" Canvas.Top="2"/>
        </Canvas>

        <ContentControl x:Name="MainContent"/>
    </Grid>
</Window>