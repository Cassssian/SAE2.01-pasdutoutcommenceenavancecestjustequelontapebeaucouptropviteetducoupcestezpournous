<UserControl x:Class="VraiPseudoSae.view.gameintro.GameIntroWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280"
             Height="720"
             Focusable="True"
             Loaded="GameIntroWindow_Loaded"
             Unloaded="GameIntroWindow_Unloaded"
             KeyDown="GameIntroWindow_KeyDown"
             KeyUp="GameIntroWindow_KeyUp"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="RetroKeyBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="216"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="28,6"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFFFFF"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroKeyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#000000" ClipToBounds="True">
        <Canvas x:Name="Viewport"
                Width="1280"
                Height="720"
                ClipToBounds="True"
                Focusable="True">
            <Canvas x:Name="WorldCanvas"
                    Width="128"
                    Height="128"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CameraScale" ScaleX="5.625" ScaleY="5.625"/>
                        <TranslateTransform x:Name="CameraTranslate" X="280" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Image x:Name="MapImage"
                       Source="pack://application:,,,/Tilemap/MapIntro.png"
                       Width="128"
                       Height="128"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       IsHitTestVisible="False"/>

                <Rectangle x:Name="PlayerSquare"
                           Width="8"
                           Height="8"
                           RadiusX="1"
                           RadiusY="1"
                           Fill="#E82424"
                           Stroke="#5A0000"
                           StrokeThickness="0.6"
                           Canvas.Left="100"
                           Canvas.Top="80"/>

                <Border x:Name="PanelKeyHint"
                        Width="18"
                        Height="9"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="2"
                        BorderThickness="0.7"
                        Background="#000000"
                        BorderBrush="#FFFFFFFF"
                        Visibility="Collapsed"
                        Canvas.Left="55"
                        Canvas.Top="30"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PanelHintRotate" Angle="0"/>
                            <TranslateTransform x:Name="PanelHintTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <TextBlock Text="E"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="6"
                               FontWeight="Bold"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextOptions.TextRenderingMode="Aliased"
                               TextOptions.TextFormattingMode="Display"/>
                </Border>
            </Canvas>
        </Canvas>

        <Path x:Name="RevealOverlay"
              Fill="#000000"
              IsHitTestVisible="False"/>

        <Border x:Name="SpaceKeyPrompt"
                Style="{StaticResource RetroKeyBorderStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SpaceKeyScale" ScaleX="1" ScaleY="1"/>
                    <SkewTransform x:Name="SpaceKeySkew" AngleX="0"/>
                    <RotateTransform x:Name="SpaceKeyRotate" Angle="0"/>
                    <TranslateTransform x:Name="SpaceKeyTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="SpaceKeyText"
                       Style="{StaticResource RetroKeyTextStyle}"
                       Text=""/>
        </Border>

        <Grid x:Name="LanguageChoiceOverlay"
              Background="#000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="980">
                <TextBlock x:Name="LanguageChoiceTitle"
                           Text=""
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"
                           TextOptions.TextRenderingMode="Aliased"
                           TextOptions.TextFormattingMode="Display"/>

                <UniformGrid Columns="2"
                             Rows="1"
                             Width="720"
                             HorizontalAlignment="Center">
                    <Border x:Name="FrenchLanguageButton"
                            Style="{StaticResource RetroKeyBorderStyle}"
                            Margin="0,0,18,0"
                            MouseEnter="FrenchLanguageButton_MouseEnter"
                            MouseLeftButtonUp="FrenchLanguageButton_MouseLeftButtonUp">
                        <TextBlock x:Name="FrenchLanguageText"
                                   Style="{StaticResource RetroKeyTextStyle}"
                                   Text=""/>
                    </Border>

                    <Border x:Name="EnglishLanguageButton"
                            Style="{StaticResource RetroKeyBorderStyle}"
                            Margin="18,0,0,0"
                            MouseEnter="EnglishLanguageButton_MouseEnter"
                            MouseLeftButtonUp="EnglishLanguageButton_MouseLeftButtonUp">
                        <TextBlock x:Name="EnglishLanguageText"
                                   Style="{StaticResource RetroKeyTextStyle}"
                                   Text=""/>
                    </Border>
                </UniformGrid>

                <TextBlock x:Name="LanguageChoiceHelpText"
                           Text=""
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FFFFFFFF"
                           Opacity="0.82"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,28,0,0"
                           TextOptions.TextRenderingMode="Aliased"
                           TextOptions.TextFormattingMode="Display"/>
            </StackPanel>
        </Grid>

        <Border x:Name="DialoguePanel"
                Width="1080"
                MinHeight="154"
                MaxHeight="310"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Padding="24,24"
                Background="#D60A0D16"
                BorderBrush="#E6F0F7B8"
                BorderThickness="3"
                CornerRadius="8"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.55"/>
            </Border.Effect>
            <WrapPanel x:Name="DialogueTextWrap"
                       Width="1024"
                       Orientation="Horizontal"
                       Margin="0,0,0,8"/>
        </Border>
    </Grid>
</UserControl>
