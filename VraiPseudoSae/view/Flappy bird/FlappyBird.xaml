<Window x:Class="VraiPseudoSae.view.Flappy_bird.FlappyBird"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flappy Bird" Height="600" Width="400"
        KeyDown="OnKeyDown" WindowStartupLocation="CenterScreen">
    <Canvas Name="GameCanvas" Background="#70c5ce" Focusable="True">
        <TextBlock Name="ScoreText" Text="Appuyez sur ESPACE" FontSize="24" FontWeight="Bold" Foreground="White" Canvas.Left="10" Canvas.Top="10" Panel.ZIndex="10"/>

        <Image Name="Bird" 
       Source="pack://application:,,,/VraiPseudoSae;component/data/Bird image.png" 
       Width="40" Height="40" 
       Canvas.Left="50" Canvas.Top="250" 
       Panel.ZIndex="5" 
       RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform x:Name="BirdRotation" Angle="0" />
            </Image.RenderTransform>
        </Image>
    </Canvas>
</Window>