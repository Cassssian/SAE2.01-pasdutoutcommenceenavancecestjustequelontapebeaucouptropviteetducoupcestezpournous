<Window x:Class="VraiPseudoSae.view.RLS_Pages.RLS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VraiPseudoSae.view.RLS_Pages"
        xmlns:ge="clr-namespace:VraiPseudoSae.view.RLS_Pages.GoalExplosions"
        Title="Rocket League 2D" 
        Width="1020" Height="640"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        Focusable="True" WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid>
        <!-- MENU -->
        <local:Menu x:Name="MainMenu"></local:Menu>
        
        <!-- GAME -->
        <Canvas x:Name="GameCanvas" Width="1000" Height="600" Background="#16213e" ClipToBounds="True" Visibility="Collapsed">
            <!-- Background Score -->
            <Viewbox Canvas.Left="0" Canvas.Top="0" Width="500" Height="520" Opacity="0.15" Panel.ZIndex="0">
                <TextBlock x:Name="ScoreP1Text" Text="0" Foreground="White" FontWeight="Bold" />
            </Viewbox>
            <Viewbox Canvas.Left="500" Canvas.Top="0" Width="500" Height="520" Opacity="0.15" Panel.ZIndex="0">
                <TextBlock x:Name="ScoreP2Text" Text="0" Foreground="White" FontWeight="Bold" />
            </Viewbox>

            <!-- Terrain / Sol -->
            <Rectangle Fill="#0f3460" Height="40" Width="1000" Canvas.Left="0" Canvas.Top="520"/>
            <Rectangle Fill="#0a2540" Height="4" Width="1000" Canvas.Left="0" Canvas.Top="520"/>
            
            <!-- But gauche : barre verticale + crossbar (barre transversale) -->
            <Rectangle Fill="#e94560" Opacity="0.25" Width="20" Height="150" Canvas.Left="0" Canvas.Top="370"/>
            <!-- Montant vertical -->
            <Rectangle Fill="White" Width="6" Height="155" Canvas.Left="20" Canvas.Top="365"/>
            <!-- Barre transversale (crossbar) -->
            <Rectangle x:Name="LeftCrossbar" Fill="White" Width="26" Height="8" Canvas.Left="0" Canvas.Top="365"/>
            <!-- Filet -->
            <Path Stroke="White" StrokeThickness="1" Opacity="0.4">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="5,375" EndPoint="5,515"/>
                        <LineGeometry StartPoint="10,375" EndPoint="10,515"/>
                        <LineGeometry StartPoint="15,375" EndPoint="15,515"/>
                        <LineGeometry StartPoint="0,400" EndPoint="20,400"/>
                        <LineGeometry StartPoint="0,440" EndPoint="20,440"/>
                        <LineGeometry StartPoint="0,480" EndPoint="20,480"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
            
            <!-- But droit -->
            <Rectangle Fill="#0f9d58" Opacity="0.25" Width="20" Height="150" Canvas.Left="980" Canvas.Top="370"/>
            <Rectangle Fill="White" Width="6" Height="155" Canvas.Left="974" Canvas.Top="365"/>
            <Rectangle x:Name="RightCrossbar" Fill="White" Width="26" Height="8" Canvas.Left="974" Canvas.Top="365"/>
            <Path Stroke="White" StrokeThickness="1" Opacity="0.4">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="985,375" EndPoint="985,515"/>
                        <LineGeometry StartPoint="990,375" EndPoint="990,515"/>
                        <LineGeometry StartPoint="995,375" EndPoint="995,515"/>
                        <LineGeometry StartPoint="980,400" EndPoint="1000,400"/>
                        <LineGeometry StartPoint="980,440" EndPoint="1000,440"/>
                        <LineGeometry StartPoint="980,480" EndPoint="1000,480"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
            
            <!-- Ligne médiane -->
            <Line X1="500" Y1="0" X2="500" Y2="520" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.3"/>
            
            <!-- Voiture 1 (rouge) - groupe détaillé -->
            <Canvas x:Name="Car1" Canvas.Left="150" Canvas.Top="490">
                <!-- Flamme boost (cachée par défaut) -->
                <Polygon x:Name="Car1Flame" Points="0,15 -20,10 -25,15 -20,20" Fill="Orange" Visibility="Collapsed"/>
                <Polygon x:Name="Car1Flame2" Points="0,15 -15,12 -18,15 -15,18" Fill="Yellow" Visibility="Collapsed"/>
                <!-- Châssis principal -->
                <Rectangle Fill="#e94560" Width="60" Height="20" Canvas.Top="8" RadiusX="4" RadiusY="4"/>
                <!-- Cockpit (toit) -->
                <Polygon Points="15,8 45,8 40,0 20,0" Fill="#b83048" Stroke="#7a1f30" StrokeThickness="1"/>
                <!-- Vitre -->
                <Polygon Points="18,7 42,7 38,2 22,2" Fill="#aaddff" Opacity="0.7"/>
                <!-- Aileron arrière -->
                <Rectangle Fill="#7a1f30" Width="6" Height="8" Canvas.Left="2" Canvas.Top="3"/>
                <Rectangle Fill="#7a1f30" Width="12" Height="2" Canvas.Left="-2" Canvas.Top="3"/>
                <!-- Phares -->
                <Ellipse Fill="Yellow" Width="4" Height="4" Canvas.Left="54" Canvas.Top="12"/>
                <!-- Roues -->
                <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="6" Canvas.Top="20"/>
                <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="10" Canvas.Top="24"/>
                <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="40" Canvas.Top="20"/>
                <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="44" Canvas.Top="24"/>
            </Canvas>
            
            <!-- Voiture 2 (vert) -->
            <Canvas x:Name="Car2" Canvas.Left="790" Canvas.Top="490">
                <Polygon x:Name="Car2Flame" Points="60,15 80,10 85,15 80,20" Fill="Orange" Visibility="Collapsed"/>
                <Polygon x:Name="Car2Flame2" Points="60,15 75,12 78,15 75,18" Fill="Yellow" Visibility="Collapsed"/>
                <Rectangle Fill="#0f9d58" Width="60" Height="20" Canvas.Top="8" RadiusX="4" RadiusY="4"/>
                <Polygon Points="15,8 45,8 40,0 20,0" Fill="#0a6e3e" Stroke="#064a29" StrokeThickness="1"/>
                <Polygon Points="18,7 42,7 38,2 22,2" Fill="#aaddff" Opacity="0.7"/>
                <Rectangle Fill="#064a29" Width="6" Height="8" Canvas.Left="52" Canvas.Top="3"/>
                <Rectangle Fill="#064a29" Width="12" Height="2" Canvas.Left="50" Canvas.Top="3"/>
                <Ellipse Fill="Yellow" Width="4" Height="4" Canvas.Left="2" Canvas.Top="12"/>
                <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="6" Canvas.Top="20"/>
                <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="10" Canvas.Top="24"/>
                <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="40" Canvas.Top="20"/>
                <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="44" Canvas.Top="24"/>
            </Canvas>
            
            <!-- Balle -->
            <Ellipse x:Name="Ball" Width="30" Height="30" Canvas.Left="485" Canvas.Top="250" Stroke="Black" StrokeThickness="2">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#cccccc" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Mode info -->
            <TextBlock x:Name="ModeText" Text="" Foreground="White" Opacity="0.7" FontSize="13" Canvas.Left="440" Canvas.Top="80"/>
            
            <!-- Boost P1 -->
            <TextBlock Text="P1 BOOST" Foreground="White" Canvas.Left="20" Canvas.Top="20" FontSize="14" FontWeight="Bold"/>
            <Rectangle Stroke="White" StrokeThickness="1" Width="150" Height="15" Canvas.Left="20" Canvas.Top="40"/>
            <Rectangle x:Name="Boost1Bar" Fill="Orange" Width="150" Height="15" Canvas.Left="20" Canvas.Top="40"/>
            
            <!-- Boost P2 -->
            <TextBlock Text="P2 BOOST" Foreground="White" Canvas.Left="830" Canvas.Top="20" FontSize="14" FontWeight="Bold"/>
            <Rectangle Stroke="White" StrokeThickness="1" Width="150" Height="15" Canvas.Left="830" Canvas.Top="40"/>
            <Rectangle x:Name="Boost2Bar" Fill="Orange" Width="150" Height="15" Canvas.Left="830" Canvas.Top="40"/>
            
            <!-- Instructions en bas -->
            <TextBlock Text="P1: A/D/W/S  •  P2: ←/→/↑/↓  •  Saut+Boost = VOL  •  R: Reset  •  ESC: Menu"
                       Foreground="White" Opacity="0.7" Canvas.Left="220" Canvas.Top="575" FontSize="12"/>
            
            <!-- Message goal -->
            <TextBlock x:Name="GoalText" Text="" FontSize="80" FontWeight="Bold" Foreground="Yellow" 
                       Canvas.Left="280" Canvas.Top="200" Visibility="Collapsed" Panel.ZIndex="100"/>

            <!-- Explosions de but -->
            <ge:GoalExplosion_Anime x:Name="GoalExplosionAnime" Panel.ZIndex="50" Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
