<Window x:Class="VraiPseudoSae.view.RLS_Pages.RLS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VraiPseudoSae.view.RLS_Pages"
        Title="Rocket League 2D" 
        Width="1020" Height="640"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        Focusable="True" WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid>
        <!-- MENU -->
        <local:Menu x:Name="MainMenu"/>

        <!-- GAME -->
        <Canvas x:Name="GameCanvas" Width="1000" Height="600" Background="#16213e" ClipToBounds="True" Visibility="Collapsed">

            <!-- Background Score -->
            <Viewbox Canvas.Left="0" Canvas.Top="0" Width="500" Height="520" Opacity="0.15" Panel.ZIndex="0">
                <TextBlock x:Name="ScoreP1Text" Text="0" Foreground="White" FontWeight="Bold"/>
            </Viewbox>
            <Viewbox Canvas.Left="500" Canvas.Top="0" Width="500" Height="520" Opacity="0.15" Panel.ZIndex="0">
                <TextBlock x:Name="ScoreP2Text" Text="0" Foreground="White" FontWeight="Bold"/>
            </Viewbox>

            <!-- Ligne médiane -->
            <Line X1="500" Y1="0" X2="500" Y2="520" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.3"/>

            <!-- Mode info -->
            <TextBlock x:Name="ModeText" Text="" Foreground="White" Opacity="0.7" FontSize="13" Canvas.Left="440" Canvas.Top="80"/>

            <!-- Boost P1 -->
            <TextBlock Text="P1 BOOST" Foreground="White" Canvas.Left="20" Canvas.Top="20" FontSize="14" FontWeight="Bold"/>
            <Rectangle Stroke="White" StrokeThickness="1" Width="150" Height="15" Canvas.Left="20" Canvas.Top="40"/>
            <Rectangle x:Name="Boost1Bar" Fill="Orange" Width="150" Height="15" Canvas.Left="20" Canvas.Top="40"/>

            <!-- Boost P2 -->
            <TextBlock Text="P2 BOOST" Foreground="White" Canvas.Left="830" Canvas.Top="20" FontSize="14" FontWeight="Bold"/>
            <Rectangle Stroke="White" StrokeThickness="1" Width="150" Height="15" Canvas.Left="830" Canvas.Top="40"/>
            <Rectangle x:Name="Boost2Bar" Fill="Orange" Width="150" Height="15" Canvas.Left="830" Canvas.Top="40"/>

            <!-- Instructions -->
            <TextBlock Text="P1: Q/D/Z/Espace  •  P2: K/M/O/Entrée  •  Saut+Boost = VOL  •  R: Reset  •  ESC: Menu"
                       Foreground="White" Opacity="0.7" Canvas.Left="180" Canvas.Top="575" FontSize="12"/>

            <!-- Message goal -->
            <TextBlock x:Name="GoalText" Text="" FontSize="80" FontWeight="Bold" Foreground="Yellow"
                       Canvas.Left="280" Canvas.Top="200" Visibility="Collapsed" Panel.ZIndex="100"/>

            <!-- ── Flamme boost voiture 1 (derrière la voiture) ── -->
            <Canvas x:Name="Flame1" Visibility="Collapsed" Panel.ZIndex="9">
                <!-- Corps principal de la flamme -->
                <Polygon Points="0,10 -28,4 -36,10 -28,16" Fill="OrangeRed" Opacity="0.95"/>
                <Polygon Points="0,10 -22,6 -28,10 -22,14" Fill="Orange"    Opacity="0.9"/>
                <Polygon Points="0,10 -16,7 -20,10 -16,13" Fill="Yellow"    Opacity="0.85"/>
                <!-- Petites langues de feu -->
                <Polygon Points="0,8  -30,2  -35,6"  Fill="OrangeRed" Opacity="0.7"/>
                <Polygon Points="0,12 -30,18 -35,14" Fill="OrangeRed" Opacity="0.7"/>
                <!-- Halo lumineux -->
                <Ellipse Width="18" Height="18" Canvas.Left="-26" Canvas.Top="1"
                         Fill="Yellow" Opacity="0.25"/>
            </Canvas>

            <!-- ── Flamme boost voiture 2 (derrière la voiture, miroir) ── -->
            <Canvas x:Name="Flame2" Visibility="Collapsed" Panel.ZIndex="9">
                <Polygon Points="60,10 88,4  96,10  88,16" Fill="OrangeRed" Opacity="0.95"/>
                <Polygon Points="60,10 82,6  88,10  82,14" Fill="Orange"    Opacity="0.9"/>
                <Polygon Points="60,10 76,7  80,10  76,13" Fill="Yellow"    Opacity="0.85"/>
                <Polygon Points="60,8  90,2  95,6"  Fill="OrangeRed" Opacity="0.7"/>
                <Polygon Points="60,12 90,18 95,14" Fill="OrangeRed" Opacity="0.7"/>
                <Ellipse Width="18" Height="18" Canvas.Left="68" Canvas.Top="1"
                         Fill="Yellow" Opacity="0.25"/>
            </Canvas>

            <!-- Explosions de but -->
            <!-- Slot pour l’explosion courante -->
            <Canvas x:Name="GoalExplosionLayer"
                    Width="1000" Height="600"
                    IsHitTestVisible="False"
                    Panel.ZIndex="50"/>
            
            <!-- FLASH GOAL -->
            <Rectangle x:Name="GoalFlashWhite"
                       Width="1000"
                       Height="520"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Fill="#FFFFFFFF"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Panel.ZIndex="180"/>

            <Rectangle x:Name="GoalFlashPowder"
                       Width="1000"
                       Height="520"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Panel.ZIndex="181"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <SolidColorBrush x:Name="GoalFlashPowderFill" Color="#FFFF4FA3"/>
                </Rectangle.Fill>

                <Rectangle.OpacityMask>
                    <RadialGradientBrush x:Name="GoalFlashPowderMaskBrush"
                                         MappingMode="RelativeToBoundingBox"
                                         Center="0.06,0.83"
                                         GradientOrigin="0.06,0.83"
                                         RadiusX="0.03"
                                         RadiusY="0.06"
                                         SpreadMethod="Pad">
                        <GradientStop Color="#FF000000" Offset="0.00"/>
                        <GradientStop Color="#FF000000" Offset="0.04"/>
                        <GradientStop Color="#F6000000" Offset="0.08"/>
                        <GradientStop Color="#E4000000" Offset="0.12"/>
                        <GradientStop Color="#C8000000" Offset="0.18"/>
                        <GradientStop Color="#A0000000" Offset="0.26"/>
                        <GradientStop Color="#76000000" Offset="0.36"/>
                        <GradientStop Color="#4A000000" Offset="0.50"/>
                        <GradientStop Color="#22000000" Offset="0.68"/>
                        <GradientStop Color="#08000000" Offset="0.84"/>
                        <GradientStop Color="#00000000" Offset="1.00"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            
        </Canvas>

        <!-- ═══════════════════════════════════════════════════════════════
             SOURCES XAML DES SPRITES
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Sprite voiture 1 (rouge, 60×34) -->
        <Canvas x:Name="SpriteCar1Source" Width="60" Height="34" Visibility="Collapsed">
            <Rectangle Fill="#e94560" Width="60" Height="20" Canvas.Top="8" RadiusX="4" RadiusY="4"/>
            <Polygon Points="15,8 45,8 40,0 20,0" Fill="#b83048" Stroke="#7a1f30" StrokeThickness="1"/>
            <Polygon Points="18,7 42,7 38,2 22,2" Fill="#aaddff" Opacity="0.7"/>
            <Rectangle Fill="#7a1f30" Width="6" Height="8" Canvas.Left="2" Canvas.Top="3"/>
            <Rectangle Fill="#7a1f30" Width="12" Height="2" Canvas.Left="-2" Canvas.Top="3"/>
            <Ellipse Fill="Yellow" Width="4" Height="4" Canvas.Left="54" Canvas.Top="12"/>
            <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="6" Canvas.Top="20"/>
            <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="10" Canvas.Top="24"/>
            <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="40" Canvas.Top="20"/>
            <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="44" Canvas.Top="24"/>
        </Canvas>

        <!-- Sprite voiture 2 (vert, 60×34) -->
        <Canvas x:Name="SpriteCar2Source" Width="60" Height="34" Visibility="Collapsed">
            <Rectangle Fill="#0f9d58" Width="60" Height="20" Canvas.Top="8" RadiusX="4" RadiusY="4"/>
            <Polygon Points="15,8 45,8 40,0 20,0" Fill="#0a6e3e" Stroke="#064a29" StrokeThickness="1"/>
            <Polygon Points="18,7 42,7 38,2 22,2" Fill="#aaddff" Opacity="0.7"/>
            <Rectangle Fill="#064a29" Width="6" Height="8" Canvas.Left="52" Canvas.Top="3"/>
            <Rectangle Fill="#064a29" Width="12" Height="2" Canvas.Left="50" Canvas.Top="3"/>
            <Ellipse Fill="Yellow" Width="4" Height="4" Canvas.Left="2" Canvas.Top="12"/>
            <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="6" Canvas.Top="20"/>
            <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="10" Canvas.Top="24"/>
            <Ellipse Fill="#1a1a1a" Stroke="#888" StrokeThickness="1" Width="14" Height="14" Canvas.Left="40" Canvas.Top="20"/>
            <Ellipse Fill="#555" Width="6" Height="6" Canvas.Left="44" Canvas.Top="24"/>
        </Canvas>

        <!-- Sprite balle (30×30) -->
        <Canvas x:Name="SpriteBallSource" Width="30" Height="30" Visibility="Collapsed">
            <Ellipse Width="30" Height="30" Stroke="Black" StrokeThickness="2">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#cccccc" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Sprite cage gauche (26×160) -->
        <Canvas x:Name="SpriteGoalSource" Width="26" Height="160" Visibility="Collapsed">
            <Rectangle Fill="#e94560" Opacity="0.25" Width="20" Height="150" Canvas.Left="0" Canvas.Top="5"/>
            <Rectangle Fill="White" Width="6" Height="155" Canvas.Left="20" Canvas.Top="0"/>
            <Rectangle Fill="White" Width="26" Height="8" Canvas.Left="0" Canvas.Top="0"/>
            <Path Stroke="White" StrokeThickness="1" Opacity="0.4">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="5,10"  EndPoint="5,150"/>
                        <LineGeometry StartPoint="10,10" EndPoint="10,150"/>
                        <LineGeometry StartPoint="15,10" EndPoint="15,150"/>
                        <LineGeometry StartPoint="0,35"  EndPoint="20,35"/>
                        <LineGeometry StartPoint="0,75"  EndPoint="20,75"/>
                        <LineGeometry StartPoint="0,115" EndPoint="20,115"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- Sprite demi-sol gauche (500×40) -->
        <Canvas x:Name="SpriteFloorSource" Width="500" Height="40" Visibility="Collapsed">
            <Rectangle Fill="#0f3460" Height="40" Width="500"/>
            <Rectangle Fill="#0a2540" Height="4"  Width="500"/>
        </Canvas>

    </Grid>
</Window>
