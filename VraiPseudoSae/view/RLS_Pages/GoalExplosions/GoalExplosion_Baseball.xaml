<goalExplosion:GoalExplosionBase x:Class="VraiPseudoSae.view.RLS_Pages.GoalExplosions.GoalExplosion_Baseball"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:goalExplosion="clr-namespace:VraiPseudoSae.data.GoalExplosion"
             Width="1000"
             Height="600"
             IsHitTestVisible="False">
    <Canvas x:Name="Root"
            Width="1000"
            Height="600"
            ClipToBounds="True"
            IsHitTestVisible="False">

        <!-- TRAILS BAT -->
        <Canvas x:Name="BatTrail3"
                Width="300"
                Height="70"
                Opacity="0.08"
                Visibility="Collapsed"
                RenderTransformOrigin="0.12,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BatTrail3Rotate" Angle="-110"/>
            </Canvas.RenderTransform>
            <Rectangle Width="220" Height="34" RadiusX="16" RadiusY="16" Fill="#66D7A86E" StrokeThickness="0" Canvas.Left="38" Canvas.Top="18"/>
            <Rectangle Width="54" Height="14" RadiusX="7" RadiusY="7" Fill="#668D6E63" StrokeThickness="0" Canvas.Left="0" Canvas.Top="28"/>
        </Canvas>

        <Canvas x:Name="BatTrail2"
                Width="300"
                Height="70"
                Opacity="0.14"
                Visibility="Collapsed"
                RenderTransformOrigin="0.12,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BatTrail2Rotate" Angle="-110"/>
            </Canvas.RenderTransform>
            <Rectangle Width="220" Height="34" RadiusX="16" RadiusY="16" Fill="#88D7A86E" StrokeThickness="0" Canvas.Left="38" Canvas.Top="18"/>
            <Rectangle Width="54" Height="14" RadiusX="7" RadiusY="7" Fill="#888D6E63" StrokeThickness="0" Canvas.Left="0" Canvas.Top="28"/>
        </Canvas>

        <Canvas x:Name="BatTrail1"
                Width="300"
                Height="70"
                Opacity="0.22"
                Visibility="Collapsed"
                RenderTransformOrigin="0.12,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BatTrail1Rotate" Angle="-110"/>
            </Canvas.RenderTransform>
            <Rectangle Width="220" Height="34" RadiusX="16" RadiusY="16" Fill="#AAD7A86E" StrokeThickness="0" Canvas.Left="38" Canvas.Top="18"/>
            <Rectangle Width="54" Height="14" RadiusX="7" RadiusY="7" Fill="#AA8D6E63" StrokeThickness="0" Canvas.Left="0" Canvas.Top="28"/>
        </Canvas>

        <!-- BAT -->
        <Canvas x:Name="GiantBat"
                Width="300"
                Height="70"
                Opacity="1"
                Visibility="Collapsed"
                RenderTransformOrigin="0.12,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="GiantBatRotate" Angle="-110"/>
            </Canvas.RenderTransform>
            <Rectangle Width="220" Height="34" RadiusX="16" RadiusY="16" Fill="#FFD7A86E" Stroke="#FF111111" StrokeThickness="3" Canvas.Left="38" Canvas.Top="18"/>
            <Rectangle Width="54" Height="14" RadiusX="7" RadiusY="7" Fill="#FF8D6E63" Stroke="#FF111111" StrokeThickness="3" Canvas.Left="0" Canvas.Top="28"/>
        </Canvas>

        <!-- TRAILS BALL -->
        <Canvas x:Name="BallTrail3"
                Width="150"
                Height="150"
                Opacity="0.08"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BallTrail3Rotate" Angle="0"/>
            </Canvas.RenderTransform>
            <Ellipse Width="150" Height="150" Fill="#55FFFFFF" StrokeThickness="0"/>
        </Canvas>

        <Canvas x:Name="BallTrail2"
                Width="150"
                Height="150"
                Opacity="0.14"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BallTrail2Rotate" Angle="0"/>
            </Canvas.RenderTransform>
            <Ellipse Width="150" Height="150" Fill="#77FFFFFF" StrokeThickness="0"/>
        </Canvas>

        <Canvas x:Name="BallTrail1"
                Width="150"
                Height="150"
                Opacity="0.22"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BallTrail1Rotate" Angle="0"/>
            </Canvas.RenderTransform>
            <Ellipse Width="150" Height="150" Fill="#99FFFFFF" StrokeThickness="0"/>
        </Canvas>

        <!-- MAIN BALL -->
        <Canvas x:Name="BaseballBall"
                Width="150"
                Height="150"
                Opacity="1"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BaseballBallRotate" Angle="0"/>
            </Canvas.RenderTransform>

            <Ellipse Width="150" Height="150" Fill="#FFFDFDFD" Stroke="#FF111111" StrokeThickness="4"/>
            <Path Stroke="#FFD32F2F" StrokeThickness="5" Data="M 35,25 C 12,52 12,98 35,125"/>
            <Path Stroke="#FFD32F2F" StrokeThickness="2.4" Data="M 28,38 L 40,43 M 24,54 L 36,59 M 22,72 L 34,77 M 22,90 L 34,95 M 27,108 L 39,113"/>
            <Path Stroke="#FFD32F2F" StrokeThickness="5" Data="M 115,25 C 138,52 138,98 115,125"/>
            <Path Stroke="#FFD32F2F" StrokeThickness="2.4" Data="M 108,43 L 120,38 M 114,59 L 126,54 M 116,77 L 128,72 M 116,95 L 128,90 M 111,113 L 123,108"/>
        </Canvas>

        <!-- IMPACT -->
        <Ellipse x:Name="HitFlash"
                 Width="60"
                 Height="60"
                 Opacity="0"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.35,0.35">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFF176" Offset="0.4"/>
                    <GradientStop Color="#00FFF176" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HitFlashScale" ScaleX="0.2" ScaleY="0.2"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="HitRing"
                 Width="120"
                 Height="120"
                 Stroke="#FFFFB300"
                 StrokeThickness="8"
                 Opacity="0"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HitRingScale" ScaleX="0.2" ScaleY="0.2"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="DustCloud"
                 Width="190"
                 Height="110"
                 Opacity="0"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#B08D6E63" Offset="0"/>
                    <GradientStop Color="#608D6E63" Offset="0.6"/>
                    <GradientStop Color="#008D6E63" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DustCloudScale" ScaleX="0.5" ScaleY="0.5"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Canvas x:Name="ParticlesLayer"
                Width="1000"
                Height="600"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>
    </Canvas>
</goalExplosion:GoalExplosionBase>