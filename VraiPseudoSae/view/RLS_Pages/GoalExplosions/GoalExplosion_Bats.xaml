<goalExplosion:GoalExplosionBase x:Class="VraiPseudoSae.view.RLS_Pages.GoalExplosions.GoalExplosion_Bats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:goalExplosion="clr-namespace:VraiPseudoSae.data.GoalExplosion"
             Width="1000"
             Height="600"
             IsHitTestVisible="False">
    <Canvas x:Name="Root"
            Width="1000"
            Height="600"
            ClipToBounds="True"
            Background="Transparent"
            IsHitTestVisible="False">

        <!-- FOND NUIT -->
        <Rectangle x:Name="NightFade"
                   Width="1000"
                   Height="600"
                   Opacity="0"
                   Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0F1024" Offset="0"/>
                    <GradientStop Color="#FF1F1B46" Offset="0.55"/>
                    <GradientStop Color="#FF090A14" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- LUNE -->
        <Ellipse x:Name="Moon"
                 Width="210"
                 Height="210"
                 Canvas.Left="670"
                 Canvas.Top="35"
                 Fill="#FFF2E6A7"
                 Stroke="#66FFF8D0"
                 StrokeThickness="3"
                 Opacity="0"
                 Visibility="Collapsed">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="0" Color="#FFF4E9A3" Opacity="0.55"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- SKYLINE LOIN -->
        <Canvas x:Name="BackBuildings" Visibility="Collapsed" Opacity="0">
            <Rectangle Width="110" Height="170" Fill="#FF28285A" Canvas.Left="10" Canvas.Top="290"/>
            <Rectangle Width="120" Height="220" Fill="#FF2C2C62" Canvas.Left="90" Canvas.Top="240"/>
            <Rectangle Width="100" Height="145" Fill="#FF262654" Canvas.Left="220" Canvas.Top="315"/>
            <Rectangle Width="140" Height="255" Fill="#FF2D2D68" Canvas.Left="300" Canvas.Top="205"/>
            <Rectangle Width="105" Height="190" Fill="#FF242450" Canvas.Left="430" Canvas.Top="270"/>
            <Rectangle Width="125" Height="235" Fill="#FF2A2A5F" Canvas.Left="520" Canvas.Top="225"/>
            <Rectangle Width="100" Height="160" Fill="#FF23234B" Canvas.Left="650" Canvas.Top="300"/>
            <Rectangle Width="145" Height="250" Fill="#FF2D2D68" Canvas.Left="730" Canvas.Top="210"/>
            <Rectangle Width="110" Height="175" Fill="#FF262654" Canvas.Left="875" Canvas.Top="285"/>
        </Canvas>

        <!-- SKYLINE AVANT -->
        <Canvas x:Name="FrontBuildings" Visibility="Collapsed" Opacity="0">
            <Rectangle Width="150" Height="240" Fill="#FF090B18" Canvas.Left="0" Canvas.Top="360"/>
            <Rectangle Width="130" Height="320" Fill="#FF070910" Canvas.Left="95" Canvas.Top="280"/>
            <Rectangle Width="120" Height="255" Fill="#FF101427" Canvas.Left="210" Canvas.Top="345"/>
            <Rectangle Width="160" Height="345" Fill="#FF05070E" Canvas.Left="310" Canvas.Top="255"/>
            <Rectangle Width="110" Height="235" Fill="#FF0B0E1B" Canvas.Left="450" Canvas.Top="365"/>
            <Rectangle Width="150" Height="300" Fill="#FF060811" Canvas.Left="535" Canvas.Top="300"/>
            <Rectangle Width="130" Height="260" Fill="#FF101427" Canvas.Left="665" Canvas.Top="340"/>
            <Rectangle Width="165" Height="335" Fill="#FF05070E" Canvas.Left="760" Canvas.Top="265"/>
            <Rectangle Width="110" Height="245" Fill="#FF0A0D18" Canvas.Left="900" Canvas.Top="355"/>
        </Canvas>

        <!-- BRUME -->
        <Ellipse x:Name="Fog1"
                 Width="500"
                 Height="140"
                 Canvas.Left="80"
                 Canvas.Top="390"
                 Fill="#33D6CFF5"
                 Opacity="0"
                 Visibility="Collapsed"/>
        <Ellipse x:Name="Fog2"
                 Width="580"
                 Height="160"
                 Canvas.Left="400"
                 Canvas.Top="410"
                 Fill="#22CFC7F0"
                 Opacity="0"
                 Visibility="Collapsed"/>

        <!-- CONTAINER DES CHAUVE-SOURIS -->
        <Canvas x:Name="BatLayer"
                Width="1000"
                Height="600"
                Visibility="Collapsed"/>

        <!-- FLASH -->
        <Ellipse x:Name="ImpactFlash"
                 Width="130"
                 Height="130"
                 Canvas.Left="435"
                 Canvas.Top="205"
                 Opacity="0"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFF7E37C" Offset="0.45"/>
                    <GradientStop Color="#00F7E37C" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="ImpactFlashScale" ScaleX="0.2" ScaleY="0.2"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- TEXTE -->
        <TextBlock x:Name="ComicText"
                   Text="BATS!"
                   FontFamily="Impact"
                   FontSize="72"
                   FontWeight="Bold"
                   Foreground="#FFF3E07A"
                   Opacity="0"
                   Visibility="Collapsed"
                   Canvas.Left="390"
                   Canvas.Top="78">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="4" Color="#FF000000" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>
    </Canvas>
</goalExplosion:GoalExplosionBase>