<goalExplosion:GoalExplosionBase x:Class="VraiPseudoSae.view.RLS_Pages.GoalExplosions.GoalExplosion_Beachballs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:goalExplosion="clr-namespace:VraiPseudoSae.data.GoalExplosion"
             Width="1000"
             Height="600"
             IsHitTestVisible="False">
    <Canvas x:Name="Root"
            Width="1000"
            Height="600"
            ClipToBounds="True"
            Background="Transparent"
            IsHitTestVisible="False">

        <!-- TAS DE SABLE - positions gérées en C# -->
        <Ellipse x:Name="SandPileL0" Width="110" Height="38" Opacity="0" Visibility="Collapsed">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFE8C97A" Offset="0"/><GradientStop Color="#FFC8A24A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="SandPileL1" Width="68" Height="28" Opacity="0" Visibility="Collapsed">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFF0D48A" Offset="0"/><GradientStop Color="#FFD4AE5C" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="SandPileR0" Width="110" Height="38" Opacity="0" Visibility="Collapsed">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFE8C97A" Offset="0"/><GradientStop Color="#FFC8A24A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="SandPileR1" Width="68" Height="28" Opacity="0" Visibility="Collapsed">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFF0D48A" Offset="0"/><GradientStop Color="#FFD4AE5C" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>

        <!-- SEAU ROUGE -->
        <Canvas x:Name="Bucket1" Visibility="Collapsed" Opacity="0">
            <Path Fill="#FFFF4470" Stroke="#FFCC1144" StrokeThickness="2" Data="M 4,0 L 40,0 L 46,44 L -2,44 Z"/>
            <Rectangle Width="46" Height="7" Fill="#FFFF6090" RadiusX="2" RadiusY="2" Canvas.Top="0"/>
            <Path Stroke="#FF888888" StrokeThickness="3" Fill="Transparent" Data="M 8,0 C 9,-14 33,-14 34,0"/>
            <Path Fill="#FFFFFFFF" Opacity="0.5" Data="M 22,16 L 24,22 L 30,22 L 25,26 L 27,32 L 22,28 L 17,32 L 19,26 L 14,22 L 20,22 Z"/>
        </Canvas>

        <!-- PELLE BLEUE -->
        <Canvas x:Name="Shovel1" Visibility="Collapsed" Opacity="0">
            <Rectangle Width="7" Height="52" Fill="#FF60A5FA" RadiusX="3" RadiusY="3" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform><RotateTransform Angle="-22"/></Rectangle.RenderTransform>
            </Rectangle>
            <Path Fill="#FFFFCC4D" Stroke="#FFCCAA00" StrokeThickness="1.5" Data="M -10,0 C -10,-10 10,-10 10,0 L 8,18 L -8,18 Z" Canvas.Left="3" Canvas.Top="45"/>
        </Canvas>

        <!-- SEAU BLEU -->
        <Canvas x:Name="Bucket2" Visibility="Collapsed" Opacity="0">
            <Path Fill="#FF22BBEE" Stroke="#FF0088BB" StrokeThickness="2" Data="M 4,0 L 36,0 L 41,38 L -1,38 Z"/>
            <Rectangle Width="40" Height="6" Fill="#FF44DDFF" RadiusX="2" RadiusY="2"/>
            <Path Stroke="#FF888888" StrokeThickness="3" Fill="Transparent" Data="M 7,0 C 8,-12 29,-12 30,0"/>
            <Path Fill="#FFFFFFFF" Opacity="0.5" Data="M 18,12 L 20,17 L 25,17 L 21,20 L 23,25 L 18,22 L 13,25 L 15,20 L 11,17 L 16,17 Z"/>
        </Canvas>

        <!-- PELLE VIOLETTE -->
        <Canvas x:Name="Shovel2" Visibility="Collapsed" Opacity="0">
            <Rectangle Width="7" Height="46" Fill="#FFA855F7" RadiusX="3" RadiusY="3" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform><RotateTransform Angle="20"/></Rectangle.RenderTransform>
            </Rectangle>
            <Path Fill="#FFFFD166" Stroke="#FFCCAA00" StrokeThickness="1.5" Data="M -9,0 C -9,-9 9,-9 9,0 L 7,16 L -7,16 Z" Canvas.Left="-3" Canvas.Top="37"/>
        </Canvas>

        <!-- COQUILLAGES -->
        <Canvas x:Name="Shell1" Visibility="Collapsed" Opacity="0">
            <Path Fill="#FFFFE8CC" Stroke="#FFD4A870" StrokeThickness="1.2" Data="M 0,14 C 4,2 16,-2 26,4 C 36,10 36,22 28,30 C 20,26 10,22 0,14"/>
            <Path Stroke="#FFD4A870" StrokeThickness="0.8" Fill="Transparent" Data="M 14,4 C 12,12 10,22 8,28 M 20,3 C 18,12 17,22 16,28 M 8,6 C 7,14 6,22 4,26"/>
        </Canvas>
        <Canvas x:Name="Shell2" Visibility="Collapsed" Opacity="0">
            <Path Fill="#FFFFD1DC" Stroke="#FFCC8899" StrokeThickness="1.2" Data="M 0,10 C 6,0 18,-2 24,6 C 30,14 28,24 20,28 C 14,22 6,16 0,10"/>
            <Path Stroke="#FFCC8899" StrokeThickness="0.8" Fill="Transparent" Data="M 12,2 C 11,10 9,18 7,24 M 17,2 C 16,10 15,18 14,24"/>
        </Canvas>
        <Canvas x:Name="Shell3" Visibility="Collapsed" Opacity="0">
            <Path Fill="#FFFFEEAA" Stroke="#FFCC9933" StrokeThickness="1" Data="M 18,16 C 30,6 38,10 36,20 C 34,30 22,32 14,26 C 6,20 8,8 18,6 C 26,4 30,10 28,18"/>
        </Canvas>

        <!-- BALLON DE PLAGE -->
        <Canvas x:Name="BeachBall" Width="180" Height="180" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BeachBallScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="BeachBallRotate" Angle="0"/>
                    <TranslateTransform x:Name="BeachBallTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="180" Height="180">
                <Ellipse.Fill><RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#FFFAFAFA" Offset="0"/><GradientStop Color="#FFE0E0E0" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><DropShadowEffect ShadowDepth="6" BlurRadius="10" Color="#44000000" Opacity="0.5"/></Ellipse.Effect>
            </Ellipse>
            <Path Fill="#FFFF4455" Data="M 90,90 L 90,0 A 90,90 0 0 1 168,45 Z"/>
            <Path Fill="#FFFFD700" Data="M 90,90 L 168,45 A 90,90 0 0 1 168,135 Z"/>
            <Path Fill="#FF22DDCC" Data="M 90,90 L 168,135 A 90,90 0 0 1 90,180 Z"/>
            <Path Fill="#FFFFFFFF" Data="M 90,90 L 90,180 A 90,90 0 0 1 12,135 Z"/>
            <Path Fill="#FFFF4455" Data="M 90,90 L 12,135 A 90,90 0 0 1 12,45 Z"/>
            <Path Fill="#FFFFD700" Data="M 90,90 L 12,45 A 90,90 0 0 1 90,0 Z"/>
            <Ellipse Width="52" Height="32" Canvas.Left="44" Canvas.Top="28" Opacity="0.55">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="14" Height="14" Fill="#FFEEEEEE" Stroke="#FFCCCCCC" StrokeThickness="2" Canvas.Left="83" Canvas.Top="83"/>
        </Canvas>

        <!-- DÉBRIS EXPLOSION -->
        <Canvas x:Name="BallDebrisLayer" Width="1000" Height="600" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ONDE DE CHOC -->
        <Ellipse x:Name="ShockRing" Width="10" Height="10" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke><SolidColorBrush Color="#FFFFFFFF"/></Ellipse.Stroke>
            <Ellipse.StrokeThickness>6</Ellipse.StrokeThickness>
            <Ellipse.Fill>Transparent</Ellipse.Fill>
            <Ellipse.RenderTransform><ScaleTransform x:Name="ShockRingScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- PARTICULES EAU -->
        <Canvas x:Name="WaterParticleLayer" Width="1000" Height="600" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ÉCLABOUSSURES -->
        <Canvas x:Name="SplashBurst" Width="1000" Height="600" Visibility="Collapsed" Opacity="0">
            <Path Fill="#CCE8F8FF" Data="M 0,0 C 18,-28 46,-32 68,-18 C 84,-8 88,10 82,26 C 62,18 32,16 0,0" Canvas.Left="706" Canvas.Top="365"/>
            <Path Fill="#AACFE8FF" Data="M 0,0 C -14,-24 -8,-46 8,-54 C 22,-44 28,-22 20,0" Canvas.Left="755" Canvas.Top="340"/>
            <Path Fill="#BBDDF4FF" Data="M 0,0 C 20,-22 44,-18 54,0 C 44,8 24,8 0,0" Canvas.Left="760" Canvas.Top="330"/>
            <Path Fill="#99C8F0FF" Data="M 0,0 C 16,-30 40,-36 56,-20 C 40,-10 20,-4 0,0" Canvas.Left="798" Canvas.Top="352"/>
        </Canvas>

        <!-- ===== TEXTE SPLASH - piloté entièrement en C# via MatrixTransform ===== -->
        <TextBlock x:Name="SplashText"
                   Width="340"
                   TextAlignment="Center"
                   Text="Splash !"
                   FontFamily="Impact"
                   FontSize="104"
                   FontWeight="Bold"
                   Foreground="#FFFFFFFF"
                   Opacity="0"
                   Visibility="Collapsed"
                   Canvas.Left="330"
                   Canvas.Top="240"
                   RenderTransformOrigin="0.5,0.5">
            <!-- MatrixTransform = contrôle total depuis C# -->
            <TextBlock.RenderTransform>
                <MatrixTransform x:Name="SplashMatrix"/>
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
                <DropShadowEffect x:Name="SplashShadow"
                                  BlurRadius="6"
                                  ShadowDepth="10"
                                  Color="#FF0055AA"
                                  Opacity="1"
                                  Direction="270"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- GOUTTES LENTILLE CAMÉRA -->
        <Canvas x:Name="LensDropLayer" Width="1000" Height="600" Visibility="Collapsed" IsHitTestVisible="False"/>

    </Canvas>
</goalExplosion:GoalExplosionBase>
