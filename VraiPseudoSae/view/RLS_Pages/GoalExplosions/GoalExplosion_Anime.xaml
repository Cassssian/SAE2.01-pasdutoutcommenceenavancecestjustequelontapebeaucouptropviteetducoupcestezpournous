<local:GoalExplosionBase x:Class="VraiPseudoSae.view.RLS_Pages.GoalExplosions.GoalExplosion_Anime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VraiPseudoSae.data.GoalExplosion"
             Width="1000" Height="600"
             IsHitTestVisible="False">
    <Canvas x:Name="RootCanvas" Width="1000" Height="600">
        <!-- Flash plein écran -->
        <Rectangle x:Name="Flash"
                   Width="1000" Height="600"
                   Fill="White"
                   Opacity="0" />

        <!-- Onde circulaire -->
        <Ellipse x:Name="Wave"
                 Width="40" Height="40"
                 Stroke="#FFff5ac3"
                 StrokeThickness="6"
                 Opacity="0">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="WaveScale" CenterX="20" CenterY="20" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Particules (simplement quelques ellipses) -->
        <Canvas x:Name="ParticlesCanvas" />
    </Canvas>
</local:GoalExplosionBase>