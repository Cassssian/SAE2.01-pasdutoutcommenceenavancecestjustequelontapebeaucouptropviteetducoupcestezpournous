<UserControl x:Class="VraiPseudoSae.view.RLS_Pages.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VraiPseudoSae.view.RLS_Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas x:Name="MenuCanvas" Width="1000" Height="600" Background="#16213e">
            <TextBlock Text="⚽ ROCKET LEAGUE 2D 🚗" FontSize="60" FontWeight="Bold" Foreground="#e94560" 
                       Canvas.Top="100" Canvas.Left="120" HorizontalAlignment="Center"/>
            <TextBlock Text="SIDESWIPE EDITION" FontSize="24" Foreground="White" Opacity="0.7"
                       Canvas.Left="400" Canvas.Top="185"/>
            
            <Button x:Name="Btn2P" Content="👥  2 JOUEURS" Width="300" Height="70" FontSize="24" FontWeight="Bold"
                    Canvas.Left="350" Canvas.Top="280" Background="#e94560" Foreground="White" 
                    BorderBrush="White" BorderThickness="2" Cursor="Hand" Click="Btn2P_Click"/>
            
            <Button x:Name="Btn1P" Content="🤖  1 JOUEUR vs BOT" Width="300" Height="70" FontSize="24" FontWeight="Bold"
                    Canvas.Left="350" Canvas.Top="370" Background="#0f9d58" Foreground="White"
                    BorderBrush="White" BorderThickness="2" Cursor="Hand" Click="Btn1P_Click"/>
            
            <Button x:Name="Custom" Content="🛠️ Custom tes voitures" Width="300" Height="70" FontSize="24" FontWeight="Bold"
                    Canvas.Left="350" Canvas.Top="460" Background="Indigo" Foreground="White"
                    BorderBrush="White" BorderThickness="2" Cursor="Hand" Click="CustomCar"></Button>
        </Canvas>
    </Grid>
</UserControl>
